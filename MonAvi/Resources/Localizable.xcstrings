    "Ahorrar parte de tus ingresos, cumplir tus metas a tiempo y tus presupuestos te da cupones de descuento en comercios aliados.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving part of your income, hitting your goals on time, and sticking to your budgets earns you discount coupons at partner merchants."
          }
        }
      }
    },
