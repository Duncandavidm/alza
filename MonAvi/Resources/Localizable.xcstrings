    "Elige **Correo**. En **Remitente**, escribe el correo de avisos de tu banco.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose **Email**. In **Sender**, type the email address your bank sends alerts from."
          }
        }
      }
