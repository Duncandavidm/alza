    "Pide siempre tu factura fiscal al pagar y escanéala: cada factura te da cashback para canjear premios.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always ask for your receipt when you pay and scan it: every receipt earns you cashback to redeem for rewards."
          }
        }
      }
    },
    "Pide tu factura fiscal": {
      "localizations": {
