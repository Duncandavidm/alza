          "stringUnit": {
            "state": "translated",
            "value": "Contact us"
          }
        }
      }
    },
    "Ese día te preguntamos si ya está disponible y te ayudamos a pasarlo a otra cuenta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That day we'll ask if it's available and help you move it to another account."
