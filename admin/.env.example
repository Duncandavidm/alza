# Copiar a .env.local para desarrollo local. En Vercel, estas mismas
# variables se configuran en Project Settings > Environment Variables
# del proyecto "monavi-admin" (ver admin/README.md).

# URL del proyecto de Supabase (publica, no es secreta).
SUPABASE_URL=https://jfhevxztsvnlsuwkwtmd.supabase.co

# SERVICE ROLE KEY de Supabase — Dashboard > Project Settings > API >
# service_role. Nunca el anon/publishable key: este panel necesita
# saltarse RLS para ver filas que la app movil no ve (reportes de
# banco, compras ambiguas, etc). NUNCA exponer esto al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# El mismo secreto que ADMIN_JOB_SECRET en las Edge Functions
# (supabase secrets set ADMIN_JOB_SECRET=...) — este panel lo manda en
# el header x-admin-secret para poder disparar
# reconcile-card-transactions y reconcile-savings-reports.
ADMIN_JOB_SECRET=

# Clave compartida para entrar al panel (no hay usuarios individuales).
ADMIN_PANEL_PASSWORD=

# Cualquier cadena larga y aleatoria — firma la cookie de sesion.
# Generar con: openssl rand -hex 32
SESSION_SECRET=
