<resources>
    <style name="Theme.MonAvi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/monavi_background</item>
    </style>
    <style name="Theme.MonAvi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/monavi_teal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MonAvi</item>
    </style>
</resources>
