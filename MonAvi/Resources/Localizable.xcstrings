            "value": "Manage subscription"
          }
        }
      }
    },
    "Agrega los botones de MonAvi al Centro de control y anota un gasto o escanea una factura en segundos, sin buscar la app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the MonAvi buttons to Control Center and log an expense or scan a receipt in seconds, without hunting for the app."
          }
        }
      }
    },
    "Agrega tus pagos fijos (renta, suscripciones) y te los recordamos cada mes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your recurring payments (rent, subscriptions) and we'll remind you every month."
          }
        }
      }
    },
