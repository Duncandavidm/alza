    "Este gasto pasa tu cupo disponible (%@). El banco podría rechazarlo o cobrarte sobregiro.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This expense exceeds your available credit (%@). The bank might decline it or charge you an overdraft fee."
