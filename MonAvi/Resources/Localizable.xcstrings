          "stringUnit": {
            "state": "translated",
            "value": "Not a recurring expense"
          }
        }
      }
    },
    "No escuché el monto. Intenta de nuevo, por ejemplo: «gasté 12 dólares en almuerzo».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I didn't catch the amount. Try again, for example: “I spent 12 dollars on lunch.”"
